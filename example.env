# AFFiNE for FreeBSD (Daemonless)
# Copy to .env and edit.

# Where AFFiNE keeps its config and uploads
AFFINE_DATA_LOCATION=/containers/affine/config

# Where PostgreSQL keeps its data files
DB_DATA_LOCATION=/containers/affine/postgres

# PostgreSQL password. Change this to a random password!
# Use only characters A-Za-z0-9 (no special characters or spaces)
DB_PASSWORD=affine

# Timezone (TZ identifier, e.g. Europe/Berlin)
# TZ=UTC

# Public hostname / scheme, if AFFiNE is reached through a reverse proxy
# AFFINE_SERVER_HOST=affine.example.com
# AFFINE_SERVER_HTTPS=true
